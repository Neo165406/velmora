// Firestore security rules for Velmora — REFERENCE COPY.
// These are NOT applied automatically. Paste them into
// Firebase Console -> Firestore Database -> Rules -> Publish,
// after replacing REPLACE_WITH_ADMIN_EMAIL with the email you use to log in to dashboard.html.
// Compare with your current rules first and keep anything else you rely on.
//
// Why this matters: buyers now sign up in the same Firebase project as the admin.
// Without these rules, any signed-in buyer could edit products and read every order.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'REPLACE_WITH_ADMIN_EMAIL';
    }

    // Storefront content: everyone can read, only the admin can change
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /slides/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // Style Inspo: anyone can send a photo (it starts as 'pending'); the public can only
    // read approved photos; only the admin can approve, hide or delete.
    match /styleInspo/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['image', 'name', 'caption', 'status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.image is string
                    && request.resource.data.image.matches('https://.*')
                    && request.resource.data.image.size() < 500
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() <= 140
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Orders: guests and buyers can place an order; a buyer can read only their own;
    // the admin can read and manage all of them.
    match /orders/{id} {
      allow create: if !('userId' in request.resource.data)
                    || (request.auth != null && request.resource.data.userId == request.auth.uid);
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Buyer profile (name, phone, address): only that buyer
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
